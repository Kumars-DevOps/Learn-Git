# main.tf

# Configure the minimum required Terraform version and providers
terraform {
  # Specifies the required providers and their sources/versions
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0" # Constrains the provider version
    }
  }


# Configure the AWS provider with a specific region
provider "aws" {
  region = "us-east-1" # Can also use a variable here: var.aws_region
}

# Define a resource (e.g., an S3 bucket)
resource "aws_s3_bucket" "example_bucket" {
  bucket = "my-unique-bucket-name-12345" # Bucket names must be globally unique
  tags = {
    Environment = "Dev"
    Project     = "InitialConfig"
  }
}

